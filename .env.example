# OpenReel local services
ORCHESTRATOR_PORT=4041
ORCHESTRATOR_AUTH_OWNER_ID=local-owner
ORCHESTRATOR_AUTH_TOKEN=

# WaveSpeed Generation V2 remains fail-closed until the independent release gate passes.
WAVESPEED_API_KEY=
WAVESPEED_BASE_URL=https://api.wavespeed.ai/api/v3
GENERATION_ROUTE_MANIFEST_JSON=[]
GENERATION_V2_RELEASE_ENABLED=false

# Durable generation state. Never configure blob:, local:, file:, or loopback URLs here.
MV_GENERATION_DATA_DIR=./generated-assets/generation
